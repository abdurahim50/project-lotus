<mxfile host="drawio"><diagram name="Security architecture" id="security"><mxGraphModel adaptiveColors="auto" pageWidth="1860" pageHeight="1540"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Project Lotus: security architecture (target)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="32" as="geometry"/></mxCell><mxCell id="sub" value="Fictional company, no real data. Blue = built and verified · orange = in progress · dashed = planned. No account ID, IP addresses or endpoints shown." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1600" height="24" as="geometry"/></mxCell><mxCell id="cA" value="Engineers and source control (outside AWS)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F7F8FA;swimlaneFillColor=#F7F8FA;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1460" height="170" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b&gt;App repos + CI (private)&lt;/b&gt;&lt;br&gt;backend (8 services) · frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="cA"><mxGeometry x="20" y="50" width="240" height="90" as="geometry"/></mxCell><mxCell id="eng" value="&lt;b&gt;Engineer laptop&lt;/b&gt;&lt;br&gt;SSO only · kubectl · bootstrap by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="cA"><mxGeometry x="280" y="50" width="240" height="90" as="geometry"/></mxCell><mxCell id="gitops" value="&lt;b&gt;zen-gitops (planned)&lt;/b&gt;&lt;br&gt;Manifests per environment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="cA"><mxGeometry x="540" y="50" width="240" height="90" as="geometry"/></mxCell><mxCell id="gha" value="&lt;b&gt;zen-infra (public) + GitHub Actions&lt;/b&gt;&lt;br&gt;PR checks: lint, Trivy, DCO · short-lived OIDC tokens, no stored AWS keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="cA"><mxGeometry x="800" y="50" width="640" height="90" as="geometry"/></mxCell><mxCell id="cU" value="Internet (untrusted)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F7F8FA;swimlaneFillColor=#F7F8FA;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="1500" y="80" width="320" height="170" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Users (planned)&lt;/b&gt;&lt;br&gt;Pharma staff, HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="cU"><mxGeometry x="40" y="50" width="240" height="90" as="geometry"/></mxCell><mxCell id="aws" value="AWS account, us-east-1" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F3FAF5;swimlaneFillColor=#F3FAF5;strokeColor=#8BCB9F;dashed=1;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1800" height="1010" as="geometry"/></mxCell><mxCell id="idc" value="Identity and state (bootstrap: applied by a human only)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="aws"><mxGeometry x="20" y="40" width="1440" height="140" as="geometry"/></mxCell><mxCell id="ipush" value="&lt;b&gt;zen-ci-image-push&lt;/b&gt;&lt;br&gt;main of app repos only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="20" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="state" value="&lt;b&gt;Terraform state&lt;/b&gt;&lt;br&gt;S3 versioned + KMS, TLS only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="255" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="oidc" value="&lt;b&gt;GitHub OIDC provider&lt;/b&gt;&lt;br&gt;trusts immutable repo IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="490" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;zen-infra-plan&lt;/b&gt;&lt;br&gt;pull requests · read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="725" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b&gt;zen-infra-apply&lt;/b&gt;&lt;br&gt;dev approval · explicit denies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="960" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="bnd" value="&lt;b&gt;Workload boundary&lt;/b&gt;&lt;br&gt;caps every pipeline role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="idc"><mxGeometry x="1195" y="45" width="210" height="80" as="geometry"/></mxCell><mxCell id="shr" value="shared (always on)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="aws"><mxGeometry x="20" y="200" width="540" height="130" as="geometry"/></mxCell><mxCell id="ecr" value="&lt;b&gt;ECR: 9 repositories&lt;/b&gt;&lt;br&gt;immutable tags · scan on push · KMS" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="shr"><mxGeometry x="20" y="45" width="500" height="70" as="geometry"/></mxCell><mxCell id="mgd" value="AWS managed services" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="aws"><mxGeometry x="20" y="350" width="540" height="640" as="geometry"/></mxCell><mxCell id="kms" value="&lt;b&gt;KMS keys&lt;/b&gt;&lt;br&gt;state, images, EKS secrets, database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="mgd"><mxGeometry x="20" y="50" width="500" height="70" as="geometry"/></mxCell><mxCell id="cw" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;EKS audit, RDS, VPC flow logs · 7 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="mgd"><mxGeometry x="20" y="140" width="500" height="70" as="geometry"/></mxCell><mxCell id="ct" value="&lt;b&gt;CloudTrail&lt;/b&gt;&lt;br&gt;every API call, all regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="mgd"><mxGeometry x="20" y="230" width="500" height="70" as="geometry"/></mxCell><mxCell id="sm" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;RDS-managed master password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="mgd"><mxGeometry x="20" y="520" width="500" height="80" as="geometry"/></mxCell><mxCell id="mgdn" value="Terraform never sees the database password; logs and keys stay in the account." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5A626E;" vertex="1" parent="mgd"><mxGeometry x="20" y="330" width="500" height="50" as="geometry"/></mxCell><mxCell id="vpc" value="VPC dev (created and destroyed each session)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#9DB8F2;dashed=1;fontColor=#1B1F24;" vertex="1" parent="aws"><mxGeometry x="580" y="200" width="1200" height="790" as="geometry"/></mxCell><mxCell id="pub" value="Public subnets" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F7F8FA;swimlaneFillColor=#F7F8FA;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="vpc"><mxGeometry x="20" y="45" width="1160" height="120" as="geometry"/></mxCell><mxCell id="nat" value="&lt;b&gt;NAT gateway&lt;/b&gt;&lt;br&gt;outbound only, one shared (ADR-001)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="pub"><mxGeometry x="20" y="40" width="300" height="65" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b&gt;Ingress load balancer (planned)&lt;/b&gt;&lt;br&gt;single HTTPS entry point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="pub"><mxGeometry x="840" y="40" width="300" height="65" as="geometry"/></mxCell><mxCell id="prv" value="Private subnets" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F7F8FA;swimlaneFillColor=#F7F8FA;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="vpc"><mxGeometry x="20" y="185" width="1160" height="400" as="geometry"/></mxCell><mxCell id="eks" value="&lt;b&gt;EKS control plane&lt;/b&gt;&lt;br&gt;private endpoint + public limited to one /32 (TB4) · access entries only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="prv"><mxGeometry x="20" y="45" width="340" height="100" as="geometry"/></mxCell><mxCell id="nodes" value="&lt;b&gt;Worker nodes&lt;/b&gt;&lt;br&gt;2 x t3.medium · IMDSv2, hop limit 1 · encrypted disks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="prv"><mxGeometry x="410" y="45" width="340" height="100" as="geometry"/></mxCell><mxCell id="argo" value="&lt;b&gt;Argo CD (planned)&lt;/b&gt;&lt;br&gt;pulls manifests from zen-gitops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="prv"><mxGeometry x="800" y="200" width="340" height="100" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Pod Identity agent&lt;/b&gt;&lt;br&gt;hands each pod its own role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="prv"><mxGeometry x="20" y="200" width="340" height="100" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;inventory pod (in progress)&lt;/b&gt;&lt;br&gt;role allows login as svc_inventory only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="prv"><mxGeometry x="410" y="200" width="340" height="100" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;Services and web UI (planned)&lt;/b&gt;&lt;br&gt;one role per service, same pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="prv"><mxGeometry x="800" y="45" width="340" height="100" as="geometry"/></mxCell><mxCell id="imds" value="Pods cannot reach the node's credentials: a test pod's metadata request timed out (verified)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#5A626E;" vertex="1" parent="prv"><mxGeometry x="20" y="320" width="1120" height="40" as="geometry"/></mxCell><mxCell id="dbt" value="Database subnets (no route to the internet)" style="swimlane;startSize=30;html=1;fontSize=15;fontStyle=1;align=left;spacingLeft=10;rounded=1;arcSize=1;fillColor=#F7F8FA;swimlaneFillColor=#F7F8FA;strokeColor=#D5DAE1;dashed=1;fontColor=#1B1F24;" vertex="1" parent="vpc"><mxGeometry x="20" y="605" width="1160" height="165" as="geometry"/></mxCell><mxCell id="rds" value="&lt;b&gt;RDS PostgreSQL 18&lt;/b&gt;&lt;br&gt;TLS required · CMK · IAM database login · 5432 from the cluster only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="dbt"><mxGeometry x="410" y="40" width="340" height="110" as="geometry"/></mxCell><mxCell id="e1" value="TB1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="gha" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="TB2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="gha" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="TB3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="apps" target="ipush"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="ipush" target="ecr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="TB4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="eng" target="state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="apply" target="vpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="ecr" target="nodes"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="TB5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="inv" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="TB6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="inv" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="TB7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="users" target="ing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="ing" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontColor=#B03A2E;fontStyle=1;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="rds" target="sm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="key" value="&lt;b&gt;Trust boundaries (what crosses each one, and the control)&lt;/b&gt;&lt;br&gt;&lt;b&gt;TB1&lt;/b&gt; GitHub to AWS on pull requests: an OIDC token for this repo (immutable IDs) gets only the read-only plan role&lt;br&gt;&lt;b&gt;TB2&lt;/b&gt; Merge to main: the apply role is issued only after a required reviewer approves the dev environment&lt;br&gt;&lt;b&gt;TB3&lt;/b&gt; App repos to ECR: only workflows on main can assume the image-push role&lt;br&gt;&lt;b&gt;TB4&lt;/b&gt; Engineer to AWS: SSO only (no IAM users); EKS API public endpoint limited to one /32; bootstrap applied only by a human&lt;br&gt;&lt;b&gt;TB5&lt;/b&gt; Pod to AWS: Pod Identity gives short-lived credentials to one namespace and service account&lt;br&gt;&lt;b&gt;TB6&lt;/b&gt; Pod to database: TLS required, IAM token for one svc_ user, port 5432 from the cluster security group only&lt;br&gt;&lt;b&gt;TB7&lt;/b&gt; Internet to ingress (planned): HTTPS only, one entry point" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="1300" width="1180" height="210" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;No static AWS keys anywhere.&lt;br&gt;Every role the pipeline creates carries the workload boundary.&lt;br&gt;The pipeline never runs bootstrap.&lt;br&gt;Dev is destroyed after each session; bootstrap and shared stay.&lt;br&gt;Each verified control links to its proof in the project README." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="1220" y="1300" width="600" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
