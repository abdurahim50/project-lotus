<mxfile host="drawio"><diagram name="Delivery flow" id="del"><mxGraphModel adaptiveColors="auto" pageWidth="1880" pageHeight="820"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Project Lotus: delivery flow" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="s" value="How a change reaches AWS. Solid = built and verified · dashed = planned · yellow = human approval gate · red = blocked." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=left;fontColor=#5A626E;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="24" as="geometry"/></mxCell><mxCell id="L1" value="Infrastructure (zen-infra, public)" style="swimlane;horizontal=0;startSize=150;html=1;fontSize=15;fontStyle=1;fillColor=#F6F9FF;strokeColor=#D5DAE1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1820" height="200" as="geometry"/></mxCell><mxCell id="i1" value="&lt;b&gt;Branch + signed commit&lt;/b&gt;&lt;br&gt;pre-commit: fmt, validate, tflint, gitleaks, no commits to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="170" y="50" width="230" height="100" as="geometry"/></mxCell><mxCell id="i2" value="&lt;b&gt;Pull request checks&lt;/b&gt;&lt;br&gt;lint · Trivy (pinned, hash-verified) · DCO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="440" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="i3" value="&lt;b&gt;Plan comment&lt;/b&gt;&lt;br&gt;read-only plan role (OIDC) · account ID masked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="680" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="i4" value="&lt;b&gt;Review&lt;/b&gt;&lt;br&gt;squash merge to main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="920" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="i5" value="&lt;b&gt;Approve dev?&lt;/b&gt;&lt;br&gt;required reviewer" style="shape=rhombus;rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="1160" y="55" width="180" height="90" as="geometry"/></mxCell><mxCell id="i6" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;apply role, issued only after approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="1380" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="i7" value="&lt;b&gt;Verify + destroy&lt;/b&gt;&lt;br&gt;post-merge proof comment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L1"><mxGeometry x="1610" y="60" width="190" height="80" as="geometry"/></mxCell><mxCell id="L2" value="Bootstrap (identity, state, boundary)" style="swimlane;horizontal=0;startSize=150;html=1;fontSize=15;fontStyle=1;fillColor=#FFF7F2;strokeColor=#D5DAE1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1820" height="140" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;Engineer laptop&lt;/b&gt;&lt;br&gt;SSO, plan and apply by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L2"><mxGeometry x="170" y="30" width="230" height="80" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Simulate policies&lt;/b&gt;&lt;br&gt;explicit denies proven before PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L2"><mxGeometry x="440" y="30" width="200" height="80" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;PR records the change&lt;/b&gt;&lt;br&gt;code matches what is live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L2"><mxGeometry x="680" y="30" width="200" height="80" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Pipeline&lt;/b&gt;&lt;br&gt;never runs bootstrap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L2"><mxGeometry x="920" y="30" width="200" height="80" as="geometry"/></mxCell><mxCell id="L3" value="Applications (backend, frontend)" style="swimlane;horizontal=0;startSize=150;html=1;fontSize=15;fontStyle=1;fillColor=#F3FAF5;strokeColor=#D5DAE1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1820" height="200" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;Pull request (planned)&lt;/b&gt;&lt;br&gt;build · unit tests · SAST · dependency scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="L3"><mxGeometry x="170" y="60" width="230" height="80" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Build image (planned)&lt;/b&gt;&lt;br&gt;image scan · SBOM · cosign signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="L3"><mxGeometry x="440" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Push to ECR&lt;/b&gt;&lt;br&gt;main only (OIDC role) · immutable tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;fontColor=#1B1F24;" vertex="1" parent="L3"><mxGeometry x="680" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Update digest (planned)&lt;/b&gt;&lt;br&gt;PR to zen-gitops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="L3"><mxGeometry x="920" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Argo CD sync dev (planned)&lt;/b&gt;&lt;br&gt;signed images only (Kyverno)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="L3"><mxGeometry x="1160" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Promote qa, prod (planned)&lt;/b&gt;&lt;br&gt;by PR · manual sync in prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;dashed=1;fontColor=#5A626E;fontSize=14;" vertex="1" parent="L3"><mxGeometry x="1400" y="60" width="200" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="i1" target="i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="i2" target="i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="i3" target="i4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="i4" target="i5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;fontColor=#1E7F3E;" edge="1" parent="1" source="i5" target="i6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="i6" target="i7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;endArrow=none;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A626E;fontSize=13;labelBackgroundColor=default;dashed=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Why it is safe&lt;/b&gt;&lt;br&gt;No stored AWS keys: every job gets short-lived OIDC credentials for one role.&lt;br&gt;Pull requests can only read; changes apply only after a human approves the dev environment.&lt;br&gt;The pipeline cannot change its own permissions: bootstrap is applied by a human and protected by explicit denies." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=14;fillColor=#FFF9DB;strokeColor=#E9D58A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1820" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
